# ===== 应用配置 =====
APP_NAME=rag-knowledge
LOG_LEVEL=INFO
# ===== postgreSQL (docker-compose 与后端共用) =====
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag_kb
POSTGRES_PORT=5432
# 后端连接串：注意使用asyncpg driver
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_kb
# ===== 腾讯云COS =====
COS_SECRET_ID=your_cos_secret_id_here
COS_SECRET_KEY=your_cos_secret_key_here
COS_REGION=ap-guangzhou
COS_BUCKET=your_cos_bucket_here
# ===== cors =====
CORS_ORIGINS=http://localhost:5173
